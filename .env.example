APP_NAME="Job Board"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CALENDAR_CREDENTIALS_PATH=app/private/google-calendar-service-account.json
GOOGLE_CALENDAR_ID=

JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_PATH=app/private/jaas-private-key.pem

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Production email: MAIL_MAILER=brevo sends through Brevo's HTTPS API, since
# Render's free tier blocks outbound SMTP. MAIL_FROM_ADDRESS must be a sender
# verified in Brevo. Local development keeps using MAIL_MAILER=smtp.
# BREVO_API_KEY=

# Backup email transport, not active: MAIL_MAILER=resend sends through Resend's
# HTTPS API (Laravel's built-in driver + the resend/resend-php SDK). Works on
# hosts without curl_multi_exec (its SDK uses Guzzle). MAIL_FROM_ADDRESS must
# be on a domain verified in Resend — until then Resend only allows the test
# sender onboarding@resend.dev, and only to the account owner's own address.
# RESEND_API_KEY=

# Production (Docker / Render) only. The image ships without credential files;
# docker/entrypoint.sh writes them to the *_PATH locations above from these.
# Prefer the *_BASE64 form (e.g. `base64 -w0 <file>`) — dashboards mangle
# multi-line values. Leave the *_PATH variables unset in production.
# GOOGLE_CALENDAR_CREDENTIALS_JSON=
# GOOGLE_CALENDAR_CREDENTIALS_BASE64=
# JAAS_PRIVATE_KEY=
# JAAS_PRIVATE_KEY_BASE64=
# Managed MySQL that requires TLS (e.g. Aiven): the CA certificate PEM.
# MYSQL_SSL_CA_CERT=
# MYSQL_SSL_CA_CERT_BASE64=

VITE_APP_NAME="${APP_NAME}"
