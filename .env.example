APP_NAME="Job Board"
APP_ENV=local
# Generate with: php artisan key:generate (use --show to print it for a hosting
# dashboard). Required — the Docker entrypoint refuses to start without it.
APP_KEY=
# Rotating APP_KEY: comma-separated old keys, so existing encrypted data still reads.
# APP_PREVIOUS_KEYS=
APP_DEBUG=false
# This API's own public URL. In production use its https:// URL — URL
# generation is forced to https only when this value starts with https://.
APP_URL=http://localhost:8000

# The React frontend's origin. Used for CORS (exact match — no trailing slash)
# and for the links in notification and password-reset emails.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development defaults to SQLite. For MySQL (Laragon, or a managed host
# such as Aiven / InfinityFree) set DB_CONNECTION=mysql and fill in the values
# your database provider shows. Managed MySQL that requires TLS also needs the
# CA certificate — see MYSQL_SSL_CA_CERT / MYSQL_ATTR_SSL_CA below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail transport: log (writes to the log; default), smtp (local, e.g. Gmail app
# password or Mailpit), brevo or resend (production HTTPS APIs — see below).
# For local Gmail SMTP: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com,
# MAIL_PORT=587, MAIL_USERNAME=<your address>, MAIL_PASSWORD=<a Google App Password>.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Calendar (interview events). Path is relative to storage/. Get the
# service-account JSON from Google Cloud Console (IAM > Service Accounts > Keys),
# save it there (never commit it), and share the target calendar with the
# service account's email. GOOGLE_CALENDAR_ID is in that calendar's settings
# under "Integrate calendar". If the credentials file is missing, calendar sync
# is skipped (a warning is logged) rather than failing the request.
GOOGLE_CALENDAR_CREDENTIALS_PATH=app/private/google-calendar-service-account.json
GOOGLE_CALENDAR_ID=

# 8x8 JaaS (interview video calls). From the JaaS console (jaas.8x8.vc):
# the App ID and, under API Keys, the Key ID; download the generated private
# key (.pem) into the storage/ path below (never commit it).
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_PATH=app/private/jaas-private-key.pem

# Google Gemini (resume parsing and semantic job matching). Create a key in
# Google AI Studio (aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Production email: MAIL_MAILER=brevo sends through Brevo's HTTPS API, since
# Render's free tier blocks outbound SMTP. MAIL_FROM_ADDRESS must be a sender
# verified in Brevo. Local development keeps using MAIL_MAILER=smtp.
# API key: Brevo dashboard > SMTP & API > API Keys (starts with xkeysib-).
# BREVO_API_KEY=
# How the Brevo transport makes its HTTP call: auto (default — falls back to
# Laravel's HTTP client when the host has curl_multi_exec disabled, e.g.
# InfinityFree), laravel (always), or symfony (never).
# BREVO_HTTP_CLIENT=auto

# Backup email transport, not active: MAIL_MAILER=resend sends through Resend's
# HTTPS API (Laravel's built-in driver + the resend/resend-php SDK). Works on
# hosts without curl_multi_exec (its SDK uses Guzzle). MAIL_FROM_ADDRESS must
# be on a domain verified in Resend — until then Resend only allows the test
# sender onboarding@resend.dev, and only to the account owner's own address.
# API key: Resend dashboard > API Keys (starts with re_).
# RESEND_API_KEY=

# Production (Docker / Render) only. The image ships without credential files;
# docker/entrypoint.sh writes them to the *_PATH locations above from these.
# Prefer the *_BASE64 form (e.g. `base64 -w0 <file>`) — dashboards mangle
# multi-line values. Leave the *_PATH variables unset in production.
# GOOGLE_CALENDAR_CREDENTIALS_JSON=
# GOOGLE_CALENDAR_CREDENTIALS_BASE64=
# JAAS_PRIVATE_KEY=
# JAAS_PRIVATE_KEY_BASE64=
# Managed MySQL that requires TLS (e.g. Aiven): the CA certificate PEM, from
# the provider's dashboard. The entrypoint writes it to a file and sets
# MYSQL_ATTR_SSL_CA (the path the database config reads) itself; set
# MYSQL_ATTR_SSL_CA directly only if you supply a certificate file yourself.
# MYSQL_SSL_CA_CERT=
# MYSQL_SSL_CA_CERT_BASE64=
# MYSQL_ATTR_SSL_CA=
# The port nginx listens on is provided by the platform ($PORT on Render;
# defaults to 10000) — don't set it in the dashboard.

VITE_APP_NAME="${APP_NAME}"
